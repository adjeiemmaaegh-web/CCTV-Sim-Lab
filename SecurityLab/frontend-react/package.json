{
  "name": "securitylab-react-workstation",
  "version": "0.17.0",
  "private": true,
  "type": "module",
  "description": "SecurityLab Stage 15 integrated offline-first engineering simulator source (no accounts, cloud or database)",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "npm run check && vite build && node scripts-build-pwa.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm test && npm run build && playwright test",
    "package": "npm run build && node scripts-package.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@types/node": "22.19.7",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.3.0",
    "fflate": "^0.8.2",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
